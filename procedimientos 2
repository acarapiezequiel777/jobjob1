END //
DELIMITER ;
15) Agregar una provincia.
DELIMITER //
CREATE PROCEDURE sp_agregar_provincia(
IN p_nombre VARCHAR(60),
IN p_capital VARCHAR(60),
IN p_gobernador VARCHAR(60),
IN p_poblacion INT,
IN p_superficie INT,
IN p_autonoma_desde DATE)
BEGIN
INSERT INTO provincias(nombre,capital,gobernador,poblacion,superficie,autonoma_desde) VALUES(p_nombre,p_capital,p_gobernador,p_poblacion,p_superficie,p_autonoma_desde);
END //
DELIMITER;
