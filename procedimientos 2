1) Eliminar clientes que nunca realizaron compras.
DELIMITER//
CREATE PROCEDURE eliminar_clientes_sin_compras()
BEGIN
DELETE FROM clientes WHERE id NOT IN (SELECT cliente FROM compras);
END//
DELIMITER ;
2) Mostrar todas las provincias de una región.
DELIMITER//
CREATE PROCEDURE provincias_region(IN p_region VARCHAR(20))
BEGIN
SELECT * FROM provincias
WHERE region = p_region;
END//
DELIMITER ;
3) Cambiar el gobernador de una provincia.
DELIMITER//
CREATE PROCEDURE nuevo_gobernador(
IN p_id INT,
IN p_gobernador VARCHAR(60))
BEGIN
 UPDATE provincias
SET gobernador = p_gobernador WHERE id = p_id;
END//
DELIMITER;
4) Agregar un producto verificando que el precio sea positivo.
DELIMITER //
CREATE PROCEDURE producto_positivo(
IN p_descripcion VARCHAR(60),
IN p_marca VARCHAR(40),
IN p_precio DECIMAL(7,2),
IN p_stock INT)
BEGIN
IF p_precio > 0 THEN
INSERT INTO productos(descripcion,marca,precio,stock)
VALUES(p_descripcion, p_marca, p_precio,p_stock);
END IF;
END//
DELIMITER;
5) Mostrar las compras realizadas entre dos fechas.
DELIMITER//
CREATE PROCEDURE compras_fechas(
IN p_fecha1 DATE,
IN p_fecha2 DATE)
BEGIN
SELECT * FROM compras WHERE fecha BETWEEN p_fecha1 AND p_fecha2;
END//
DELIMITER ;
6) Eliminar ciudades con menos de cierta población.
DELIMITER//
CREATE PROCEDURE eliminar_ciudades(
IN p_poblacion INT)
BEGIN
DELETE FROM ciudades WHERE poblacion < p_poblacion;
END //
DELIMITER ;
7) Aumentar el stock de todos los productos de una marca.
DELIMITER//
CREATE PROCEDURE aumentar_stock(
IN p_marca VARCHAR(40),
IN p_cantidad INT)
BEGIN
UPDATE productos SET stock = stock + p_cantidad WHERE marca = p_marca;
END//
DELIMITER;
8) Mostrar todos los productos de una marca.
DELIMITER//
CREATE PROCEDURE productos_marca(
IN p_marca VARCHAR(40))
BEGIN
SELECT * FROM productos WHERE marca = p_marca;
END//
DELIMITER;
9) Eliminar todos los productos sin stock.
DELIMITER //
CREATE PROCEDURE eliminar_sin_stock()
BEGIN
DELETE FROM productos WHERE stock = 0;
END//
DELIMITER ;
10) Registrar una compra asignando automáticamente la fecha actual.
DELIMITER//
CREATE PROCEDURE sp_registrar_compra(
IN p_cliente INT,
IN p_producto INT,
IN p_cant INT)
BEGIN
INSERT INTO compras(cliente,producto,cant)
VALUES(p_cliente,p_producto,p_cant);
END //
DELIMITER;
11) Mostrar el producto más caro.
DELIMITER //
CREATE PROCEDURE sp_producto_mas_caro()
BEGIN
SELECT * FROM productos ORDER BY precio DESC LIMIT 1;
END//
DELIMITER ;
12) Reducir el stock de un producto.
DELIMITER//
CREATE PROCEDURE reducir_stock(
IN p_id INT,
IN p_cantidad INT)
BEGIN
UPDATE productos SET stock = stock - p_cantidad WHERE id = p_id;
END//
DELIMITER;
13) Eliminar provincias sin ciudades asociadas.
DELIMITER //
CREATE PROCEDURE eliminar_provincias_sin_ciudades()
BEGIN
DELETE FROM provincias WHERE id NOT IN (SELECT provincia FROM ciudades);
