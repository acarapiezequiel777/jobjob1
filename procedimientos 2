24) Aumentar todos los precios de una marca un porcentaje determinado.
DELIMITER//
CREATE PROCEDURE sp_aumentar_precio_marca(
IN p_marca VARCHAR(40),
IN p_porcentaje DECIMAL(5,2))
BEGIN
UPDATE productos
SET precio = precio + (precio * p_porcentaje / 100)
WHERE marca = p_marca;
END//
DELIMITER;
