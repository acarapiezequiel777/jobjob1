-- Cursores
-- Los cursores en SQL son punteros que permiten recorrer un conjunto de resultados fila por fila,
-- lo que es útil cuando se necesita procesar cada fila individualmente en lugar de trabajar con
-- todo el conjunto de resultados a la vez.
-- Nos permite utilizar el contenido de una tabla fila a fila y realizar operaciones especificas para cada una

--Syntaxis básica para declarar un cursor en SQL:
DECLARE nombre_cursor CURSOR FOR
   SELECT id, precio, nombre_producto
   FROM productos

    DECLARE @id INT
    DECLARE @precio DECIMAL(10, 2) 
    DECLARE @nombre_producto VARCHAR(100);
    DECLARE @subtotal DECIMAL(10, 2) = 0;

    OPEN nombre_cursor;
        FETCH NEXT FROM nombre_cursor INTO @id, @precio, @nombre_producto;
        --DECLARE CONTINUE HANDLER FOR NOT FOUND SET var = 1;
        --WHILE @@FETCH_STATUS = 0
         BEGIN 
           SELECT @id AS 'ID', @precio AS 'Precio', 
           @nombre_producto AS 'Nombre del Producto', @subtotal AS 'Subtotal';

           SET @subtotal = @subtotal + @precio;
           FETCH NEXT FROM nombre_cursor INTO @id, @precio, @nombre_producto;
        END
    CLOSE nombre_cursor;
    
DEALLOCATE nombre_cursor;













CREATE TABLE clientes (
id INT PRIMARY KEY AUTO_INCREMENT,
nombre VARCHAR(60),
apellido VARCHAR(60),

tel VARCHAR(20),
calle VARCHAR(40),
altura INT,
localidad INT,
FOREIGN KEY (localidad) REFERENCES ciudades(id)
);

