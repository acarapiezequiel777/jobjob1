 DECLARE CURSOR nombre_cursor FOR 
    SELECT nombre, apellido FROM clientes;

    DECLARE @nombre VARCHAR(60);
    DECLARE @apellido VARCHAR(60);

    OPEN nombre_cursor;
    FETCH NEXT FROM nombre_cursor INTO @nombre, @apellido;
        BEGIN
            DECLARE CONTINUE HANDLER FOR NOT FOUND loop Boolean = false;
         --   WHILE @@FETCH_STATUS = 0    
            WHILE loop
                BEGIN
                    SELECT @nombre AS 'Nombre', @apellido AS 'Apellido' WHERE
                    WHERE tel > 10000000
                    FETCH NEXT FROM nombre_cursor INTO @nombre, @apellido;
                END

            END WHILE; 
        END
    CLOSE nombre_cursor;
    
    DEALLOCATE nombre_cursor;




