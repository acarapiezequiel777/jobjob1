1- Crear una función cantidad_total_comprada(id_producto) que sume cuántas unidades se vendieron de un producto usando la tabla compras.
DELIMITER//
CREATE FUNCTION cantidad_total_comprada(id_producto INT)
RETURNS INT
BEGIN
  RETURN (SELECT SUM(cant) FROM compras WHERE producto = id_producto);
END//
DELIMITER;

