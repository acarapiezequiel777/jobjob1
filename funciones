10- Crear una función producto_mas_vendido() que devuelva el nombre del producto más vendido.
DELIMITER//
CREATE FUNCTION producto_mas_vendido()
RETURNS VARCHAR(60)
BEGIN
  RETURN (SELECT p.descripcion FROM productos p JOIN compras c ON p.id = c.producto GROUP BY p.id ORDER BY SUM(c.cant) DESC LIMIT 1);
END//
DELIMITER;
11- Crear una función producto_menos_vendido() que devuelva el nombre del producto menos vendido.
DELIMITER//
CREATE FUNCTION producto_menos_vendido()
RETURNS VARCHAR(60)
BEGIN
  RETURN (SELECT p.descripcion FROM productos p JOIN compras c ON p.id = c.producto GROUP BY p.id ORDER BY SUM(c.cant) ASC LIMIT 1);
END//
DELIMITER;
12- Crear una función promedio_precios() que devuelva el promedio de precios de todos los productos.
DELIMITER//
CREATE FUNCTION promedio_precios()
RETURNS DECIMAL(10,2)
BEGIN
RETURN (SELECT AVG(precio) FROM productos);
END//
DELIMITER;
13- Crear una función comparar_promedio(id_producto) que devuelva:
* "Arriba del promedio"
* "Debajo del promedio"
según el precio del producto comparado con el promedio general.
DELIMITER//
CREATE FUNCTION comparar_promedio(id_producto INT)
RETURNS VARCHAR(20)
BEGIN
DECLARE prom DECIMAL(10,2);
DECLARE precio_producto DECIMAL(10,2);
SET prom = promedio_precios();
SELECT precio INTO precio_producto FROM productos WHERE id = id_producto;
IF precio_producto > prom THEN
  RETURN 'Arriba del promedio';
ELSE
  RETURN 'Debajo del promedio';
END IF;
END//
DELIMITER;
14- Crear una función alerta_stock(id_producto) que devuelva:
"REPOSICION URGENTE" si stock = 0
"STOCK BAJO" si stock < 20
"OK" en otro caso.
DELIMITER//
CREATE FUNCTION alerta_stock(id_producto INT)
RETURNS VARCHAR(20)
BEGIN
  DECLARE stock_actual INT;
  SELECT stock INTO stock_actual FROM productos WHERE id = id_producto;
IF stock_actual = 0 THEN
 RETURN 'REPOSICION URGENTE';
ELSEIF stock_actual < 20 THEN
 RETURN 'STOCK BAJO';
ELSE
 RETURN 'OK';
END IF;
END//
DELIMITER;
