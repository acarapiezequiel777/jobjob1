1- Crear una función cantidad_total_comprada(id_producto) que sume cuántas unidades se vendieron de un producto usando la tabla compras.
DELIMITER//
CREATE FUNCTION cantidad_total_comprada(id_producto INT)
RETURNS INT
BEGIN
RETURN (SELECT SUM(cant) FROM compras WHERE producto = id_producto);
END//
DELIMITER;

2- Crear una función cantidad_compras_cliente(id_cliente) que devuelva cuántas compras realizó un cliente.
DELIMITER//
CREATE FUNCTION cantidad_compras_cliente(id_cliente INT)
RETURNS INT
BEGIN
RETURN (SELECT COUNT(*) FROM compras WHERE cliente = id_cliente);
END//
DELIMITER;

3- Crear una función ultima_compra(id_cliente) que devuelva la fecha de la última compra de un cliente.
DELIMITER//
CREATE FUNCTION ultima_compra(id_cliente INT)
RETURNS DATETIME
BEGIN
RETURN (SELECT MAX(fecha) FROM compras WHERE cliente = id_cliente);
END//
DELIMITER;

4- Crear una función dias_ultima_compra(id_cliente) que devuelva cuántos días pasaron desde la última compra.
DELIMITER;
CREATE FUNCTION dias_ultima_compra(id_cliente INT)
RETURNS INT
BEGIN
  DECLARE fecha_ultima DATETIME;
  DECLARE dias INT;
  SELECT MAX(fecha) INTO fecha_ultima FROM compras WHERE cliente = id_cliente;
  SET dias = DATEDIFF(CURDATE(), fecha_ultima);
  RETURN dias;
END//
DELIMITER;
5- Crear una función total_gastado(id_cliente) que calcule cuánto dinero gastó un cliente.
DELIMITER//
CREATE FUNCTION total_gastado(id_cliente INT)
RETURNS DECIMAL(10,2)
BEGIN
  RETURN (SELECT SUM(cant * p.precio) FROM compras c JOIN productos p ON c.producto = p.id WHERE c.cliente = id_cliente);
END//
DELIMITER;
6- Crear una función cliente_premium(id_cliente) que devuelva:
 * "Premium" si gastó más de 5000
 * "Normal" en caso contrario.
DELIMITER//
CREATE FUNCTION cliente_premium(id_cliente INT)
RETURNS VARCHAR(10)
BEGIN
DECLARE gasto DECIMAL(10,2);
SET gasto =total_gastado(id_cliente);
  IF gasto > 5000 THEN
  RETURN 'Premium';
ELSE
RETURN 'Normal';
END IF;
END//
DELIMITER;
7- Crear una función provincia_cliente(id_cliente) que devuelva la provincia donde vive el cliente.
DELIMITER //

CREATE FUNCTION provincia_cliente(id_cliente INT)
RETURNS VARCHAR(60)
BEGIN
  RETURN (SELECT p.nombre FROM clientes cl JOIN ciudades ci ON cl.localidad = ci.id JOIN provincias p ON ci.provincia = p.id WHERE cl.id = id_cliente);
END//
DELIMITER;
