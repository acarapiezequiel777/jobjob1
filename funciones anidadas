        Juan Pérez | Gasto: $5400 | Premium  ->  Si es premium se debe determinar con una función aparte, y lo es si gasto mas de 5000$
        
DELIMITER//
CREATE FUNCTION analisis_cliente(id_cliente INT)
RETURNS VARCHAR(200)
BEGIN
