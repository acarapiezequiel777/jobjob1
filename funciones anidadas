1- Crear una función Región_Cliente(cliente) que utilice provincia_cliente(cliente)
DELIMITER//
CREATE FUNCTION Región_Cliente(id_cliente INT)
RETURNS VARCHAR(40)
BEGIN
DECLARE resultado VARCHAR(60);
SET resultado = provincia_cliente(id_cliente);
RETURN(SELECT region FROM provincias WHERE nombre = resultado);
END//
DELIMITER;
2 - Crear una procedimiento que permita mostrar todos los objetos en el "nivel del cliente" -> mediante una función se determina el nivel del cliente
Bronce: gasto menos de 1000$
Plata: gasto menos de 3000$
ORO: gasto menos de 5000$
PLATINO: gasto mas de 5000$
el procedimiento recibirá como parámetro el rango del cliente y mostrara:
Bronce: los objetos de hasta 10$
Plata: los objetos de hasta   100$
ORO: los objetos de hasta 500$
PLATINO: los objetos de hasta 500$

DELIMITER //
CREATE FUNCTION nivel_cliente(id_cliente INT)
RETURNS VARCHAR(20)
BEGIN
DECLARE gasto DECIMAL(10,2);
SET gasto = total_gastado(id_cliente);
IF gasto < 1000 THEN
RETURN 'Bronce';
ELSEIF gasto < 3000 THEN
RETURN 'Plata';
ELSEIF gasto < 5000 THEN
RETURN 'Oro';
ELSE
RETURN 'Platino';
END IF;
END//
DELIMITER ;

