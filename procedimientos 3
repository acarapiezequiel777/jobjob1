12) Verificar si una ciudad supera cierta población.
DELIMITER //
CREATE PROCEDURE poblacion_ciudad(IN p_ciudad VARCHAR(60),IN p_poblacion INT)
BEGIN
DECLARE total INT;
SELECT poblacion INTO total FROM ciudades WHERE nombre=p_ciudad;
IF total>p_poblacion THEN
SELECT 'La poblacion es mayor' AS mensaje;
ELSE
