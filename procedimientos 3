END//
DELIMITER;
5) Mostrar región de cada cliente.
DELIMITER//
CREATE PROCEDURE region_clientes()
BEGIN
SELECT c.nombre,p.region
FROM clientes c JOIN ciudades ci ON c.localidad=ci.id JOIN provincias p ON ci.provincia=p.id;
END//
DELIMITER;
6) Determinar si un producto es rentable según sus ventas.
DELIMITER //
CREATE PROCEDURE producto_rentable(IN p_producto INT)
BEGIN
DECLARE vendidos INT;
SELECT SUM(cant) INTO vendidos FROM compras WHERE producto=p_producto;
IF vendidos>=20 THEN
SELECT 'Producto rentable' AS mensaje;
ELSE
SELECT 'Producto poco rentable' AS mensaje;
END IF;
END//
DELIMITER ;
7) Obtener la población total de una región.
DELIMITER //
CREATE PROCEDURE poblacion_region(IN p_region VARCHAR(20))
BEGIN
SELECT SUM(poblacion) AS poblacion_total FROM provincias WHERE region=p_region;
END//
DELIMITER;
8) Verificar si un cliente existe.
DELIMITER //
CREATE PROCEDURE cliente_existe(IN p_nombre VARCHAR(60))
BEGIN
DECLARE resultado VARCHAR(60);
SELECT nombre INTO resultado FROM clientes WHERE nombre = p_nombre LIMIT 1;
IF resultado IS NULL THEN
SELECT 'No existe' AS mensaje;
ELSE
SELECT 'Existe' AS mensaje;
END IF;
END//
DELIMITER ;

