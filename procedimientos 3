DELIMITER ;

20) Mostrar clientes agrupados por provincia.
DELIMITER //
CREATE PROCEDURE clientes_provincia()
BEGIN
SELECT p.nombre AS provincia,COUNT(c.id) AS cantidad_clientes FROM clientes c JOIN ciudades ci ON c.localidad=ci.id JOIN provincias p ON ci.provincia=p.id GROUP BY p.nombre;
END//
DELIMITER ;

21) Detectar posibles fraudes o errores: Mostrar todos los clientes que hayan realizado dos o más compras en un intervalo de tiempo menor a 5 minutos.
DELIMITER//
CREATE PROCEDURE posibles_fraudes()
BEGIN
SELECT c.nombre,c.apellido,c1.fecha,c2.fecha
FROM compras c1
JOIN compras c2 ON c1.cliente=c2.cliente JOIN clientes c ON c.id=c1.cliente WHERE c1.id<c2.id
AND TIMESTAMPDIFF(MINUTE,c1.fecha,c2.fecha)<5;
END//
DELIMITER ;

22) Generar un ranking de marcas: Listar el "Top 3" de las marcas más vendidas de cada región, mostrando el total recaudado por cada una.
DELIMITER //
CREATE PROCEDURE ranking_marcas()
BEGIN
SELECT pr.region,p.marca,SUM(co.cant*p.precio) AS total
FROM compras co JOIN productos p ON co.producto=p.id JOIN clientes c ON co.cliente=c.id JOIN ciudades ci ON c.localidad=ci.id JOIN provincias pr ON ci.provincia=pr.id GROUP BY pr.region,p.marca ORDER BY total DESC LIMIT 3;
END//
DELIMITER ;

23) Calcular la retención de clientes: Determinar cuántos clientes que compraron en el mes anterior volvieron a realizar una compra en el mes actual.
DELIMITER//
CREATE PROCEDURE retencion_clientes()
BEGIN
SELECT COUNT(DISTINCT cliente) AS clientes_retenidos FROM compras WHERE MONTH(fecha)=MONTH(CURDATE());
END//
DELIMITER ;

24) Actualizar precios por inflación: Aumentar un 15% los productos de una marca específica, pero solo si pertenecen a provincias con una población mayor a 1.000.000 de habitantes.
DELIMITER //
CREATE PROCEDURE aumentar_precios(IN p_marca VARCHAR(40))
BEGIN
UPDATE productos
SET precio=precio*1.15 WHERE marca=p_marca;
END//
DELIMITER;

25) Reporte de estacionalidad: Mostrar cuál es el mes del año en el que cada marca registra su mayor volumen de ventas.
DELIMITER//
CREATE PROCEDURE ventas_mes()
BEGIN
SELECT p.marca,MONTH(co.fecha) AS mes,SUM(co.cant) AS ventas 
FROM compras co JOIN productos p ON co.producto=p.id 
GROUP BY p.marca,MONTH(co.fecha) ORDER BY ventas DESC;
END//
DELIMITER ;

26) Identificar "Clientes Embajadores": Mostrar aquellos clientes que han comprado absolutamente todos los productos disponibles de una marca específica.
DELIMITER //
CREATE PROCEDURE clientes_embajadores(IN p_marca VARCHAR(40))
BEGIN
SELECT c.nombre,c.apellido FROM clientes c JOIN compras co ON c.id=co.cliente JOIN productos p ON co.producto=p.idWHERE p.marca=p_marca GROUP BY c.id,c.nombre,c.apellido;
END//
DELIMITER;
