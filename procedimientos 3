13) Mostrar cantidad comprada por cliente.
DELIMITER //
CREATE PROCEDURE cantidad_comprada()
BEGIN
SELECT c.nombre,c.apellido,SUM(co.cant) AS total_comprado
FROM clientes c JOIN compras co ON co.cliente=c.id GROUP BY c.id,c.nombre,c.apellido;
END//
DELIMITER ;

14) Informar si un producto necesita reposición.
DELIMITER //
CREATE PROCEDURE reposicion(IN p_id INT)
BEGIN
DECLARE stock_actual INT;
SELECT stock INTO stock_actual FROM productos WHERE id=p_id;
IF stock_actual<=10 THEN
SELECT 'Necesita mas stock' AS mensaje;
ELSE
SELECT 'No necesita stock' AS mensaje;
END IF;
END//
DELIMITER ;

