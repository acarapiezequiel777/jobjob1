1) Mostrar todas las compras con nombre de cliente y descripción del producto.
DELIMITER//
CREATE PROCEDURE compras_clientes()
BEGIN
SELECT c.nombre,c.apellido,p.descripcion,co.cant,co.fecha FROM compras co JOIN clientes c ON co.cliente=c.id
JOIN productos p ON co.producto=p.id;
END//
DELIMITER;
2) Calcular el precio final de una compra.
DELIMITER//
CREATE PROCEDURE precio_compra(IN p_compra INT)
BEGIN
SELECT p.descripcion,co.cant,p.precio,(co.cant*p.precio) AS total FROM compras co
JOIN productos p ON co.producto=p.id
WHERE co.id=p_compra;
END//
DELIMITER ;
3) Verificar si una compra puede realizarse.
DELIMITER //
CREATE PROCEDURE realizar_compra(IN p_cliente VARCHAR(60),IN p_producto INT,IN p_cantidad INT)
BEGIN
DECLARE v_cliente INT;
DECLARE v_stock INT;
SELECT id INTO v_cliente FROM clientes WHERE nombre=p_cliente;
SELECT stock INTO v_stock FROM productos WHERE id=p_producto;
IF v_cliente IS NOT NULL AND v_stock>=p_cantidad THEN
INSERT INTO compras(cliente,producto,cant) VALUES(v_cliente,p_producto,p_cantidad);
UPDATE productos SET stock=stock-p_cantidad WHERE id=p_producto;
SELECT 'Compra realizada' AS mensaje;
ELSE
SELECT 'No se puede realizar la compra' AS mensaje;
END IF;
END//
DELIMITER ;
4) Calcular el total gastado por un cliente.
DELIMITER //
CREATE PROCEDURE gastado_cliente(IN p_nombre VARCHAR(60))
BEGIN
